{
  "name": "BatterBox (cloud dev)",
  "user": "ubuntu",
  "install": "bash ./.cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "DATA_DIR=./data MOCK_GPIO=true .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080 --reload"
    }
  ],
  "ports": [{ "name": "web", "port": 8080 }]
}
